{
  "expo": {
    "name": "Orbit Roll",
    "slug": "orbit-roll",
    "scheme": "orbitroll",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080D18",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spacecube.orbitroll"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080D18"
      },
      "package": "com.spacecube.orbitroll",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Orbit Roll"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080D18",
          "image": "./assets/icon.png",
          "imageWidth": 130
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
