{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react"],
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "shared/**/*.ts", "scripts/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["apps", "supabase/functions", "node_modules"]
}
