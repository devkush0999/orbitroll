# Public client configuration. Never put a service-role / secret key in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS website origin, used by mobile share links.
EXPO_PUBLIC_SITE_URL=
# Separate Next.js admin origin; the Expo app never contains Cloudinary secrets.
EXPO_PUBLIC_ADMIN_URL=
